# API base URL. In dev, defaults to http://localhost:8000 if unset.
EXPO_PUBLIC_API_URL=https://your-backend.example.com

# Optional. For protected endpoints (e.g. scrape), set to match your backend's ADMIN_ACCESS_KEY.
# When set, the app sends X-Admin-Key on protected requests.
EXPO_PUBLIC_ADMIN_ACCESS_KEY=
