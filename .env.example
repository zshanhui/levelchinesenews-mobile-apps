# API base URL. In dev, defaults to http://localhost:8000 if unset.
EXPO_PUBLIC_API_URL=https://your-backend.example.com

# Optional. Backend URL for article write requests (scrape/parse, generate_summary). Falls back to EXPO_PUBLIC_API_URL if unset.
# EXPO_PUBLIC_API_WRITE_URL=https://your-write-backend.example.com

# Optional. For protected endpoints (e.g. scrape), set to match your backend's ADMIN_ACCESS_KEY.
# When set, the app sends X-Admin-Key on protected requests.
EXPO_PUBLIC_TEMP_ADMIN_ACCESS_WRITE_KEY=admin-write-access-key-dev-staging-server

# Optional. Set to 1 to show debug environment variables in Settings. Omit to hide.
# EXPO_PUBLIC_DEBUG=1

# remote url for bootstrapped local dict
EXPO_PUBLIC_REMOTE_DICT_URL=https://your-project.supabase.co/storage/v1/object/public/dictionary/cedict.json.gz
