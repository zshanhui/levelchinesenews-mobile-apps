---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((entry) => !entry.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/i, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | LevelChinese News`} description={post.data.description}>
  <article
    class:list={[
      'container',
      'post-wrap',
      post.data.postType === 'newslesson' && 'post-wrap--lesson',
    ]}
  >
    <a class="back-link" href="/news">Back to latest news</a>
    <h1>{post.data.title}</h1>
    <p class="post-date">
      {post.data.pubDate.toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
      })}
    </p>
    <div class="post-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-wrap {
    max-width: 860px;
  }

  .back-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-size: 0.88rem;
  }

  h1 {
    margin: 0.55rem 0 1.1rem;
    font-size: clamp(1.7em, 4.2vw, 2.2em);
    line-height: 1.12;
  }

  .post-date {
    margin: 0 0 1rem;
    color: var(--text-muted);
    font-size: 0.86rem;
  }

  .post-content :global(p) {
    margin: 0 0 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(mark.vocab) {
    padding: 0 0.12em;
    color: inherit;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    border-radius: 2px;
    font-weight: 600;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0.5rem 0 0.8rem;
    padding-left: 1.1rem;
  }

  .post-content :global(li) {
    margin: 0.25rem 0;
    color: var(--text-secondary);
  }

  .post-content :global(ol li) {
    margin: 0 0 1.15rem;
  }

  .post-content :global(ol li:last-child) {
    margin-bottom: 0;
  }

  .post-content :global(h2) {
    margin: 2.25rem 0 0.75rem;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.2;
  }

  .post-content :global(h2 + table) {
    margin-top: 0.35rem;
  }

  /* Section breaks (e.g. Questions) — h2s not followed by a vocabulary table */
  .post-content :global(h2:not(:has(+ table))) {
    margin-top: 4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .post-content :global(table) {
    width: 100%;
    margin: 1.75rem 0 2.25rem;
    border-collapse: collapse;
    font-size: 0.94em;
    line-height: 1.45;
    background: var(--surface-elevated);
    border: 1px solid var(--border);
    box-shadow: 0 1px 2px color-mix(in srgb, var(--text) 4%, transparent);
  }

  .post-content :global(thead) {
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
  }

  .post-content :global(th) {
    text-align: left;
    font-weight: 650;
    color: var(--text);
    padding: 0.7rem 0.9rem;
    border-bottom: 2px solid color-mix(in srgb, var(--accent) 22%, var(--border));
    font-size: 0.82em;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .post-content :global(td) {
    padding: 0.62rem 0.9rem;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .post-content :global(td:first-child) {
    color: var(--text);
    font-weight: 550;
    white-space: nowrap;
  }

  .post-content :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .post-content :global(tbody tr:nth-child(even)) {
    background: color-mix(in srgb, var(--bg) 55%, transparent);
  }

  .post-content :global(details.translation) {
    margin: 0.1rem 0 1.15rem;
    border-left: 3px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    padding: 0 0 0 0.85rem;
  }

  .post-content :global(details.translation summary) {
    cursor: pointer;
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    user-select: none;
    list-style: none;
  }

  .post-content :global(details.translation summary::-webkit-details-marker),
  .post-content :global(details.translation summary::marker) {
    display: none;
  }

  .post-content :global(details.translation summary::before) {
    content: '+ ';
    font-weight: 700;
  }

  .post-content :global(details.translation[open] summary::before) {
    content: '− ';
  }

  .post-content :global(details.translation[open] summary) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(details.translation p) {
    margin: 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.5;
    font-style: italic;
  }

  @media (max-width: 560px) {
    .post-content :global(table) {
      font-size: 0.88em;
    }

    .post-content :global(th),
    .post-content :global(td) {
      padding: 0.48rem 0.42rem;
    }

    .post-content :global(th:nth-child(2)),
    .post-content :global(th:nth-child(3)) {
      font-size: 0.68em;
    }

    .post-content :global(th:first-child),
    .post-content :global(td:first-child) {
      width: 30%;
      font-size: 0.92em;
    }

    .post-content :global(td:nth-child(2)),
    .post-content :global(td:nth-child(3)) {
      font-size: 0.72em;
      line-height: 1.35;
    }

    .post-content :global(th:nth-child(2)),
    .post-content :global(td:nth-child(2)) {
      width: 28%;
    }

    .post-content :global(th:nth-child(3)),
    .post-content :global(td:nth-child(3)) {
      width: 42%;
      word-break: break-word;
      hyphens: auto;
    }

    .post-content :global(thead),
    .post-content :global(tbody),
    .post-content :global(tr) {
      display: table;
      width: 100%;
      table-layout: fixed;
    }
  }
</style>
