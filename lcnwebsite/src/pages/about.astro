---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('about', 'about');
if (!entry) {
  throw new Error('Missing src/content/about/about.md');
}
const { Content } = await render(entry);
const { title, description } = entry.data;
---

<BaseLayout title={title} description={description}>
  <section class="container about-wrap">
    <h1>{title}</h1>
    <article>
      <div class="about-content">
        <Content />
      </div>
      <p class="contact-line">
        Reach me at
        <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
      </p>
    </article>
  </section>
</BaseLayout>

<style>
  .about-wrap {
    max-width: 820px;
  }

  h1 {
    margin: 0 0 1.35rem;
    font-size: clamp(1.65rem, 3.2vw, 2.3rem);
  }

  .about-content :global(p) {
    margin: 0 0 0.78rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .about-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .about-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .contact-line {
    margin: 0.78rem 0 0;
    color: var(--text);
  }

  .contact-line a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
