---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const origin = Astro.site ?? new URL('https://levelchinese.app');
const homeUrl = new URL('/', origin).href.replace(/\/$/, '');
const newsUrl = new URL('/news', origin).href;
const postSlug = (id: string) => id.replace(/\.(md|mdx)$/i, '');
const lessons = (await getCollection('blog'))
  .filter((entry) => !entry.data.draft && entry.data.postType === 'newslesson')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((lesson) => ({
    title: lesson.data.title,
    url: new URL(`/news/${postSlug(lesson.id)}`, origin).href,
  }));
const links = [
  { title: 'Home', url: homeUrl },
  { title: 'News', url: newsUrl },
  ...lessons,
];
---

<BaseLayout title="Page not found | LevelChinese News" description="This page does not exist.">
  <section class="container not-found">
    <h1>Page not found</h1>
    <figure class="not-found-gif">
      <img
        src="https://media.giphy.com/media/mgAcz1EFIyxmo/giphy.gif"
        alt="A red panda"
        width="480"
        height="270"
      />
      <figcaption>
        <a href="https://giphy.com/gifs/red-panda-mgAcz1EFIyxmo">via GIPHY</a>
      </figcaption>
    </figure>
    <p>That link does not exist. Try the homepage or the latest posts.</p>
    <ul class="not-found-links">
      {
        links.map((link) => (
          <li>
            <span class="link-title">{link.title}</span>
            <a href={link.url}>{link.url}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 820px;
    padding: 2rem 0 4rem;
    text-align: center;
  }

  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(1.65rem, 3.2vw, 2.3rem);
  }

  p {
    margin: 0 auto 1.25rem;
    max-width: 36rem;
    color: var(--text-secondary);
  }

  .not-found-gif {
    margin: 0 auto 1.35rem;
    max-width: min(100%, 28rem);
  }

  .not-found-gif img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .not-found-gif figcaption {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .not-found-gif figcaption a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .not-found-links {
    display: grid;
    gap: 0.55rem 0.85rem;
    margin: 0 auto;
    padding: 0;
    max-width: 40rem;
    list-style: none;
    text-align: left;
  }

  .not-found-links li {
    display: grid;
    grid-template-columns: minmax(5.5rem, 0.42fr) minmax(0, 1fr);
    gap: 0.65rem;
    align-items: baseline;
  }

  .link-title {
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .not-found-links a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
    font-size: 0.92rem;
  }

  @media (max-width: 560px) {
    .not-found-links li {
      grid-template-columns: 1fr;
      gap: 0.12rem;
    }
  }
</style>
