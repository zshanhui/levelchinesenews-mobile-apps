---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Learn Chinese by reading real native-level content with built-in dictionary, pinyin, and study tools.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@wc1font/source-han-serif-sc-vf@1.0.6/font.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/playfair-display@5.2.8/latin-600.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/playfair-display@5.2.8/latin-700.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/playfair-display@5.2.8/latin-800.css"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-logo" aria-hidden="true">
            <span class="brand-logo-bar brand-logo-bar--1"></span>
            <span class="brand-logo-bar brand-logo-bar--2"></span>
            <span class="brand-logo-bar brand-logo-bar--3"></span>
          </span>
          <span class="brand-text">{siteConfig.brandName}</span>
        </a>
        <nav class="top-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/news">News</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>Copyright @ 2026 WuweiLabs</p>
        <div class="footer-links" aria-label="Footer links">
          <a href="/privacy-policy">Privacy</a>
          <span aria-hidden="true">|</span>
          <a href="/contact">Contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>
