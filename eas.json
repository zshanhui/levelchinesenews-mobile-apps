{
  "cli": {
    "version": ">= 18.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "node": "22.17.0",
      "pnpm": "11.9.0",
      "android": {
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "node": "22.17.0",
      "pnpm": "11.9.0",
      "android": {
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.17.0",
      "pnpm": "11.9.0",
      "android": {
        "buildType": "apk",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
